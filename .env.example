# Database Connection (Supabase PostgreSQL)
# Transaction Pooler (Port 6543 with pgbouncer=true for Vercel/serverless runtime):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection (Port 5432 for migrations and schema push):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth / JWT Authentication
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"
AUTH_PROVIDER="nextauth"

# Admin Initial Provisioning (Optional for deployment)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongSecretPassword123!"
ADMIN_NAME="System Administrator"

# Microsoft Azure Blob Storage (Optional for cloud media)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=yourstorage;AccountKey=yourkey;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="videos"
AZURE_STORAGE_ACCOUNT_NAME="yourstorage"

# Video Upload Constraints
MAX_VIDEO_SIZE_MB="500"
MAX_VIDEO_DURATION_SECONDS="600"
ALLOWED_VIDEO_EXTENSIONS="mp4,webm"
