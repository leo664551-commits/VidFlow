# =========================================================
# Azure Database for PostgreSQL (Flexible Server)
# Format: postgresql://<user>:<password>@<server-name>.postgres.database.azure.com:5432/<dbname>?sslmode=require
# =========================================================
DATABASE_URL="postgresql://vidflowadmin:YourStrongPassword123!@vidflow-db.postgres.database.azure.com:5432/vidflow?sslmode=require"

# =========================================================
# NextAuth / JWT Authentication
# =========================================================
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret-for-production"
NEXTAUTH_URL="https://your-app-name.azurewebsites.net"
AUTH_PROVIDER="nextauth"

# =========================================================
# Microsoft Azure Blob Storage (Cloud Video & Avatar Storage)
# =========================================================
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=yourprimarykey==;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="videos"
AZURE_STORAGE_AVATAR_CONTAINER="avatars"
# Optional custom domain or Azure CDN endpoint:
# AZURE_STORAGE_CUSTOM_DOMAIN="https://cdn.yourdomain.com"

# =========================================================
# Admin Initial Provisioning (Optional for deployment)
# =========================================================
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongSecretPassword123!"
ADMIN_NAME="System Administrator"

# =========================================================
# Video Upload Constraints
# =========================================================
MAX_VIDEO_SIZE_MB="500"
MAX_VIDEO_DURATION_SECONDS="600"
ALLOWED_VIDEO_EXTENSIONS="mp4,webm"
